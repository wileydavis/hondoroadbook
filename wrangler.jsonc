// Cloudflare Worker for hondoroadbook.com: the product site (static files in web/site) and the
// pack catalog + downloads, served from an R2 bucket that the GitHub Actions workflow fills.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hondoroadbook",
  "main": "web/worker.js",
  "compatibility_date": "2025-09-01",
  // run_worker_first: without it, Cloudflare's static-assets layer answers browser navigations to
  // /download/* and /packs/* with the 404 page before the Worker ever runs (plain fetches were fine).
  "assets": { "directory": "web/site", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": ["/download/*", "/packs/*", "/tiles/*", "/api/*"] },
  "r2_buckets": [{ "binding": "PACKS", "bucket_name": "roadbook-packs" }],
  // The routing service: the phone's core in a container (server/Dockerfile), woken by the first
  // /api/route of the day and asleep twenty minutes after the last. Graphs download on demand from
  // the packs and stay on the instance's disk. "standard" is 4 GB of memory; raise it if a region's
  // graphs stop fitting. Deploying builds the image from the repo root (needs Docker locally).
  "containers": [{ "class_name": "RouterContainer", "image": "./server/Dockerfile", "image_build_context": ".", "max_instances": 2, "instance_type": "standard-1" }],
  "durable_objects": { "bindings": [{ "name": "ROUTER", "class_name": "RouterContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RouterContainer"] }],
  // The roadbook library: the D1 database created in the dashboard, with web/schema.sql run in its console.
  "d1_databases": [{ "binding": "DB", "database_name": "roadbook-library", "database_id": "69ac58ba-3033-4f01-bee6-3f274085fe5c" }],
  // Secrets (wrangler secret put …): BRAVE_KEY for the inspect panel's web search (optional),
  // ADMIN_TOKEN to hide or delete library entries, SALT for the daily upload counter.
  "routes": [
    { "pattern": "hondoroadbook.com", "custom_domain": true },
    { "pattern": "www.hondoroadbook.com", "custom_domain": true }
  ],
  // Worker logs stay on for errors, but invocation logs are off: they would carry every request URL, and a
  // route or search query is a position. Nothing in the code logs a URL either (see api.js).
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } }
}
