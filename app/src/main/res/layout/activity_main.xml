<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <org.maplibre.android.maps.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Turn cue -->
    <LinearLayout
        android:id="@+id/hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/bg_card"
        android:elevation="6dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp" android:paddingEnd="18dp" android:paddingTop="6dp" android:paddingBottom="6dp">

            <fold.app.ArrowView
                android:id="@+id/arrow"
                android:layout_width="104dp"
                android:layout_height="104dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:id="@+id/hudDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:text="350 m" />

                <TextView
                    android:id="@+id/hudStreet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink_soft"
                    android:textSize="18sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Table Mesa Drive" />
            </LinearLayout>

            <fold.app.CompassView
                android:id="@+id/hudCompass"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Off-track banner: the route stays fixed; rerouting is a button, never automatic -->
    <LinearLayout
        android:id="@+id/offPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/bg_accent"
        android:elevation="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp" android:paddingEnd="8dp" android:paddingTop="8dp" android:paddingBottom="8dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/offTrack"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:text="OFF TRACK  ↗ 120 m" />
        <Button
            android:id="@+id/btnReroute"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_button"
            android:textColor="@color/button_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingStart="14dp" android:paddingEnd="14dp"
            android:stateListAnimator="@null"
            android:text="REROUTE" />
    </LinearLayout>

    <!-- Scale bar, like the one in the corner of a paper map -->
    <fold.app.ScaleView
        android:id="@+id/scale"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="40dp" />

    <!-- The old small buttons: hidden, driven by the glove menu below (same handlers) -->
    <LinearLayout
        android:id="@+id/panelIdle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="20dp">
        <ImageButton android:id="@+id/btnGo" style="@style/RoundIcon" android:src="@drawable/ic_search" android:contentDescription="@string/go_to" android:layout_marginEnd="10dp" />
        <ImageButton android:id="@+id/btnTrack" style="@style/RoundIcon" android:src="@drawable/ic_track" android:contentDescription="@string/track" android:layout_marginEnd="10dp" />
        <ImageButton android:id="@+id/btnMaps" style="@style/RoundIcon" android:src="@drawable/ic_maps" android:contentDescription="@string/maps" android:layout_marginEnd="10dp" />
        <ImageButton android:id="@+id/btnRec" style="@style/RoundIcon" android:src="@drawable/ic_rec" android:contentDescription="Record" android:visibility="gone" />
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <ImageButton android:id="@+id/btnLock" style="@style/RoundIcon" android:src="@drawable/ic_unlock" android:contentDescription="Lock orientation" android:layout_marginEnd="10dp" />
        <ImageButton android:id="@+id/btnNight" style="@style/RoundIcon" android:src="@drawable/ic_night" android:contentDescription="Night" android:layout_marginEnd="10dp" />
        <ImageButton android:id="@+id/btnLocate" style="@style/RoundIcon" android:src="@drawable/ic_locate" android:contentDescription="Locate" />
    </LinearLayout>

    <!-- Recording (pre-run) strip: elapsed/distance, CUE, STOP. Shown in any mode while recording. -->
    <LinearLayout
        android:id="@+id/recStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="14dp" android:layout_marginEnd="14dp" android:layout_marginBottom="130dp"
        android:background="@drawable/bg_rec"
        android:elevation="5dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp" android:paddingEnd="8dp" android:paddingTop="8dp" android:paddingBottom="8dp"
        android:visibility="gone">
        <TextView android:id="@+id/recStatus" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="15sp" android:textStyle="bold" android:text="● REC 0:00 · 0 mi · 0 cues" />
        <Button android:id="@+id/btnRecCue" style="@style/BigButton" android:layout_width="wrap_content" android:layout_height="64dp" android:background="@drawable/bg_accent" android:textColor="#FFFFFF" android:textSize="19sp" android:paddingStart="26dp" android:paddingEnd="26dp" android:text="CUE" android:layout_marginEnd="8dp" />
        <Button android:id="@+id/btnRecStop" style="@style/BigButton" android:layout_width="wrap_content" android:layout_height="64dp" android:textSize="17sp" android:paddingStart="18dp" android:paddingEnd="18dp" android:text="STOP" />
    </LinearLayout>

    <!-- Bottom: editing a track's cues -->
    <LinearLayout
        android:id="@+id/panelEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="20dp"
        android:visibility="gone">
        <TextView android:id="@+id/editLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="15sp" android:background="@drawable/bg_card" android:padding="12dp" android:layout_marginBottom="8dp" android:maxLines="2" android:ellipsize="end" android:elevation="4dp" android:text="Long-press on the line to add a cue. Tap a cue to edit it." />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btnEditList" style="@style/BigButton" android:layout_width="0dp" android:layout_weight="1" android:text="LIST" android:layout_marginEnd="8dp" />
            <Button android:id="@+id/btnEditSave" style="@style/BigButton" android:layout_width="0dp" android:layout_weight="1" android:text="SAVE" android:layout_marginEnd="8dp" />
            <Button android:id="@+id/btnEditFollow" style="@style/BigButton" android:layout_width="0dp" android:layout_weight="2" android:background="@drawable/bg_accent" android:textColor="#FFFFFF" android:text="FOLLOW" android:layout_marginEnd="8dp" />
            <Button android:id="@+id/btnEditCancel" style="@style/BigButton" android:layout_width="48dp" android:text="✕" />
        </LinearLayout>
    </LinearLayout>

    <!-- Night and locate stay reachable while navigating, stacked clear of the nav panel -->
    <LinearLayout
        android:id="@+id/navSide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="104dp"
        android:orientation="vertical"
        android:visibility="gone">
        <!-- hidden: the menu drives these -->
        <ImageButton android:id="@+id/btnLockNav" style="@style/RoundIcon" android:src="@drawable/ic_unlock" android:contentDescription="Lock orientation" android:layout_marginBottom="12dp" />
        <ImageButton android:id="@+id/btnNightNav" style="@style/RoundIcon" android:src="@drawable/ic_night" android:contentDescription="Night" android:layout_marginBottom="12dp" />
        <ImageButton android:id="@+id/btnLocateNav" style="@style/RoundIcon" android:src="@drawable/ic_locate" android:contentDescription="Locate" />
    </LinearLayout>

    <!-- Bottom: a point was picked -->
    <LinearLayout
        android:id="@+id/panelPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="12dp" android:paddingBottom="20dp"
        android:visibility="gone">
        <TextView android:id="@+id/pinLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="16sp" android:background="@drawable/bg_card" android:padding="12dp" android:layout_marginBottom="8dp" android:maxLines="2" android:ellipsize="end" android:elevation="4dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btnRouteHere" style="@style/BigButton" android:layout_width="0dp" android:layout_weight="2" android:background="@drawable/bg_accent" android:textColor="#FFFFFF" android:text="@string/route_here" android:layout_marginEnd="8dp" />
            <Button android:id="@+id/btnVia" style="@style/BigButton" android:layout_width="0dp" android:layout_weight="1" android:text="VIA" android:layout_marginEnd="8dp" android:visibility="gone" />
            <Button android:id="@+id/btnFrom" style="@style/BigButton" android:layout_width="0dp" android:layout_weight="1" android:text="FROM" android:layout_marginEnd="8dp" />
            <ImageButton android:id="@+id/btnSavePin" style="@style/BigButton" android:layout_width="48dp" android:src="@drawable/ic_star" app:tint="@color/button_text" android:padding="12dp" android:contentDescription="Save" android:layout_marginEnd="8dp" />
            <Button android:id="@+id/btnPinCancel" style="@style/BigButton" android:layout_width="48dp" android:text="✕" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom: comparing routes -->
    <LinearLayout
        android:id="@+id/panelCompare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="12dp" android:paddingBottom="20dp"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/compareRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:elevation="4dp"
            android:paddingTop="4dp" android:paddingBottom="4dp"
            android:layout_marginBottom="8dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btnStops" style="@style/BigButton" android:layout_width="0dp" android:layout_weight="1" android:text="STOPS" android:layout_marginEnd="8dp" />
            <Button android:id="@+id/btnModes" style="@style/BigButton" android:layout_width="0dp" android:layout_weight="1" android:text="MODES" android:layout_marginEnd="8dp" />
            <Button android:id="@+id/btnSaveRoute" style="@style/BigButton" android:layout_width="0dp" android:layout_weight="1" android:text="SAVE" android:layout_marginEnd="8dp" />
            <Button android:id="@+id/btnStartNav" style="@style/BigButton" android:layout_width="0dp" android:layout_weight="1.4" android:background="@drawable/bg_accent" android:textColor="#FFFFFF" android:text="GO" android:layout_marginEnd="8dp" />
            <Button android:id="@+id/btnCompareCancel" style="@style/BigButton" android:layout_width="48dp" android:text="✕" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom: navigating — the info card above the circle; END, sound, cue live in the glove menu -->
    <LinearLayout
        android:id="@+id/panelNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="12dp" android:paddingBottom="128dp"
        android:visibility="gone">
        <LinearLayout android:id="@+id/navCard" android:layout_width="wrap_content" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_card" android:elevation="4dp" android:paddingStart="18dp" android:paddingEnd="18dp" android:clickable="true" android:focusable="true">
            <TextView android:id="@+id/navRemaining" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold" android:maxLines="1" android:includeFontPadding="false" android:text="12.4 km · 18 min" />
            <TextView android:id="@+id/navSpeed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/ink_soft" android:textSize="18sp" android:maxLines="1" android:includeFontPadding="false" android:paddingStart="14dp" android:text="45 mph" />
        </LinearLayout>
        <ImageButton android:id="@+id/btnNavCue" style="@style/RoundIcon" android:src="@drawable/ic_cue" android:contentDescription="Add cue here" android:visibility="gone" />
        <ImageButton android:id="@+id/btnSound" style="@style/RoundIcon" android:src="@drawable/ic_sound_off" android:contentDescription="Sound" android:visibility="gone" />
        <Button android:id="@+id/btnEnd" style="@style/BigButton" android:layout_width="64dp" android:text="@string/end" android:visibility="gone" />
    </LinearLayout>

    <!-- The one button a glove needs: a big translucent circle. Opens the menu. -->
    <ImageButton
        android:id="@+id/btnMenu"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="22dp"
        android:background="@drawable/bg_round_glass"
        android:src="@drawable/ic_menu"
        android:padding="26dp"
        app:tint="@color/ink"
        android:elevation="6dp"
        android:contentDescription="Menu" />

    <!-- The menu: slides up to the HUD, giant buttons, giant close bar -->
    <FrameLayout
        android:id="@+id/menuScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">
        <LinearLayout
            android:id="@+id/menuSheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="@drawable/bg_sheet"
            android:elevation="12dp"
            android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="16dp" android:paddingBottom="18dp">
            <TextView android:id="@+id/menuTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ink_soft" android:textSize="13sp" android:letterSpacing="0.12" android:text="ROADBOOK" android:gravity="center" android:paddingBottom="10dp" />
            <ScrollView
                android:id="@+id/menuScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">
                <GridLayout
                    android:id="@+id/menuGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2" />
            </ScrollView>
            <Button
                android:id="@+id/btnMenuClose"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button"
                android:textColor="@color/button_text"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:stateListAnimator="@null"
                android:drawableStart="@drawable/ic_down"
                android:drawableTint="@color/button_text"
                android:drawablePadding="12dp"
                android:paddingStart="26dp" android:paddingEnd="36dp"
                android:text="CLOSE" />
        </LinearLayout>
    </FrameLayout>

    <!-- countdown chip, placed on the map at the next turn -->
    <TextView
        android:id="@+id/turnChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:elevation="5dp"
        android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp"
        android:textColor="@color/ink"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:text="4:32" />

    <TextView
        android:id="@+id/toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="96dp"
        android:background="@drawable/bg_card"
        android:elevation="8dp"
        android:padding="14dp"
        android:textColor="@color/ink"
        android:textSize="16sp"
        android:visibility="gone" />
</FrameLayout>
